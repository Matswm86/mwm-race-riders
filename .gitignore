# Godot 4 generated cache and import files
.godot/
.import/
*.translation

# Mock sources that stay on disk only (.blend files and raw renders)
docs/mockups/src/*.blend
docs/mockups/src/*.blend1
docs/mockups/src/*_raw.png

# Tool caches
.ruff_cache/
__pycache__/
*.pyc

# OS noise
.DS_Store
Thumbs.db

# Build artifacts
*.apk
*.aab
*.ipa
build/

# Godot Gradle source template (installed in CI from export templates)
android/build/
android/.build_version

# Local screenshots from the capture bot
screenshots/raw/

# Editor
.vscode/
.idea/
*.swp

# Realistic art pass (2026-10-06): raw CC0 downloads and bake intermediates stay on disk only
assets/_raw/
# Retired toy look, kept on disk for reference (moved out of use, not deleted)
docs/mockups/old_toy/
# Blender sources never go in git
*.blend
*.blend1
